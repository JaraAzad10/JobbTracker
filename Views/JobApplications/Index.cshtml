@model List<JobApplication>
@{
    ViewData["Title"] = "Søknader";
}

<h1>Mine søknader</h1>

<p><a asp-action="Create">+ Legg til søknad</a></p>

@if (Model.Count == 0)
{
    <p>Ingen søknader ennå.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Firma</th>
                <th>Stilling</th>
                <th>Søkt</th>
                <th>Status</th>
                <th>Annonse</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Company</td>
                    <td>@a.Position</td>
                    <td>@a.AppliedDate.ToString("dd.MM.yyyy")</td>
                    <td>@a.Status</td>
                    <td>
                        @if (!string.IsNullOrEmpty(a.Url))
                        {
                            <a href="@a.Url" target="_blank">Åpne</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}