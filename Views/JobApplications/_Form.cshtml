@model JobApplicationCreateViewModel

<div asp-validation-summary="ModelOnly"></div>

<div>
    <label asp-for="Company"></label>
    <input asp-for="Company" />
    <span asp-validation-for="Company"></span>
</div>

<div>
    <label asp-for="Position"></label>
    <input asp-for="Position" />
    <span asp-validation-for="Position"></span>
</div>

<div>
    <label asp-for="AppliedDate"></label>
    <input asp-for="AppliedDate" />
</div>

<div>
    <label asp-for="Status"></label>
    <select asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()"></select>
</div>

<div>
    <label asp-for="Url"></label>
    <input asp-for="Url" />
    <span asp-validation-for="Url"></span>
</div>

<div>
    <label asp-for="Notes"></label>
    <textarea asp-for="Notes"></textarea>
</div>